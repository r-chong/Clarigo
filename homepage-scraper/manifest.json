{
  "manifest_version": 3,
  "name": "Clarigo YouTube Feed Scraper",
  "version": "1.1.0",
  "description": "Collect video metadata from YouTube feed cards for Clarigo training data",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["youtube-dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
