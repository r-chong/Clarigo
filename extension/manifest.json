{
    "name": "Clarigo Smart YouTube Blocker",
    "description": "Description",
    "version": "1.0",
    "manifest_version": 3,
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "host_permissions": [
        "*://www.youtube.com/*"
    ],
    "permissions": [
        "scripting",
        "tabs"
    ]

}
        
