# Copy this file to `.env` (which is gitignored) and fill in real values.
# Both keys are only needed for the Phase 1 data pipeline (scraping + labeling).

# YouTube Data API v3 key — for ml/scripts/youtube_category_scraper.py
# Create in Google Cloud Console: enable "YouTube Data API v3", then make an API key.
YOUTUBE_API_KEY=

# Google Gemini API key — for ml/scripts/gemini_labeler.py
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for labeling (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
