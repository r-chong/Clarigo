{
  "manifest_version": 3,
  "name": "Clarigo - YouTube Filter For Non-Educational Videos",
  "version": "0.8.0",
  "description": "Use YouTube clearly with no distractions",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}