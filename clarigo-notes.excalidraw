    {
      "id": "CzJhHexR-CC1uczKEmx9w",
      "type": "text",
      "x": 272.24029541015625,
      "y": 1553.5,
      "width": 786.5595092773438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
