      "seed": 1118159852,
      "version": 25,
      "versionNonce": 162500972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Track Precision/Recall for Educational as the “keep” class. A false negative\n(marking Edu as Ent) hides value—opt to minimize that.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Track Precision/Recall for Educational as the “keep” class. A false negative (marking Edu as Ent) hides value—opt to minimize that.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yjTdm_COthv9bztDnMxEY",
      "type": "text",
      "x": 270.99029541015625,
      "y": 5363.5,
      "width": 786.8760986328125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bc0",
      "roundness": null,
      "seed": 1987690708,
      "version": 27,
      "versionNonce": 2123513708,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Recommended operating point: Entertainment precision ≥ 0.90 (so you rarely hide\ntrue Edu), while maximizing Entertainment recall. Pick threshold via PR curve on\nthe gold set.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recommended operating point: Entertainment precision ≥ 0.90 (so you rarely hide true Edu), while maximizing Entertainment recall. Pick threshold via PR curve on the gold set.",
      "autoResize": false,
      "lineHeight": 1.25
    },
