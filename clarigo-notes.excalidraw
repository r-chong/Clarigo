      "updated": 1756176261015,
      "link": null,
      "locked": false,
      "text": "Personal retraining data: keep a rolling training.jsonl (features + label). Expose an\nExport and Import so you can retrain offline and drop in a new model.json.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Personal retraining data: keep a rolling training.jsonl (features + label). Expose an Export and Import so you can retrain offline and drop in a new model.json.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "rw6txxKRB5hccyti7du1Y",
      "type": "text",
