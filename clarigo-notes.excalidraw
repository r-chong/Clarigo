      "type": "text",
      "x": 272.24029541015625,
      "y": 3346,
      "width": 775.4594116210938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
