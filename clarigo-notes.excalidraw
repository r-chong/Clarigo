      "versionNonce": 1098562668,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Self-training: after first model, add only predictions with high confidence (e.g.,\np>0.95) to training as additional weak labels.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Self-training: after first model, add only predictions with high confidence (e.g., p>0.95) to training as additional weak labels.",
      "autoResize": false,
      "lineHeight": 1.25
    },
