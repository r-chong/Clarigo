      "versionNonce": 192004972,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689257,
      "link": null,
      "locked": false,
      "text": "Lightweight on-device fine-tune (optional): implement 5–10 SGD steps of logistic\nregression in JS on your latest corrections (just the last N examples) and persist\nthe updated w, b to chrome.storage.local.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lightweight on-device fine-tune (optional): implement 5–10 SGD steps of logistic regression in JS on your latest corrections (just the last N examples) and persist the updated w, b to chrome.storage.local.",
      "autoResize": false,
      "lineHeight": 1.25
    },
