      "updated": 1756261202991,
      "link": null,
      "locked": false,
      "text": "Class weight → Adjusting how much the loss penalizes mistakes on one class vs\nthe other. Useful if you care more about catching Entertainment than saving\nevery Edu.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Class weight → Adjusting how much the loss penalizes mistakes on one class vs the other. Useful if you care more about catching Entertainment than saving every Edu.",
      "autoResize": false,
      "lineHeight": 1.25
    },
