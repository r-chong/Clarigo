      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Store to chrome.storage.local or IndexedDB. Add an “Export CSV/JSON” button\nin your popup for training.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Store to chrome.storage.local or IndexedDB. Add an “Export CSV/JSON” button in your popup for training.",
