      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Text features (most signal per byte):",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Text features (most signal per byte):",
