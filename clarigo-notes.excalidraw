      "roundness": null,
      "seed": 1800545748,
      "version": 27,
      "versionNonce": 1767947500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Reweight examples (weak = 0.2–0.5 weight; gold = 1.0).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reweight examples (weak = 0.2–0.5 weight; gold = 1.0).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
