    {
      "id": "pKk5rGB8aaR-YTDEeaXxU",
      "type": "text",
      "x": 1656.0488517949614,
      "y": 5222.148473488593,
      "width": 772.699462890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfP",
      "roundness": null,
      "seed": 1841897282,
      "version": 4,
      "versionNonce": 1639322114,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756259558996,
      "link": null,
      "locked": false,
      "text": "Precision (Entertainment precision) → Out of all videos predicted as\nEntertainment, the fraction that really are entertainment. High precision = very\nfew false alarms (few Edu mistakenly hidden).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Precision (Entertainment precision) → Out of all videos predicted as Entertainment, the fraction that really are entertainment. High precision = very few false alarms (few Edu mistakenly hidden).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qKChoBGVqVh_uYxZYXN13",
      "type": "text",
      "x": 1662.7995939616137,
      "y": 5374.3578409478,
      "width": 437.5242921138871,
      "height": 29.050551970342894,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bfQ",
      "roundness": null,
      "seed": 105704926,
      "version": 36,
      "versionNonce": 1268493378,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1756260739028,
      "link": null,
      "locked": false,
      "text": "Recall (Entertainment recall) → Out of all entertainment videos, the fraction\ncorrectly hidden. High recall = you catch most junk.",
      "fontSize": 11.620220788137154,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recall (Entertainment recall) → Out of all entertainment videos, the fraction correctly hidden. High recall = you catch most junk.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jLKIvDEFeUc9i35eR8ZM9",
