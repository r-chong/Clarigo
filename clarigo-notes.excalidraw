      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Requires API key/OAuth and quota; the Home algorithm itself isn’t exposed,\nyou’re only enriching items you already saw.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requires API key/OAuth and quota; the Home algorithm itself isn’t exposed, you’re only enriching items you already saw.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "noKXHg-286IlVCGFTXyri",
      "type": "text",
      "x": 270.99029541015625,
      "y": 1861,
      "width": 796.1594848632812,
      "height": 100,
      "angle": 0,
