      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Train on all weak labels, hold out a manually labeled “gold” set (~300–500).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Train on all weak labels, hold out a manually labeled “gold” set (~300–500).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "g_gaKjy94ycuRH4tX_n87",
      "type": "text",
      "x": 270.99029541015625,
      "y": 5058.5,
      "width": 538.5996704101562,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
