      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Train offline in Python (scikit-learn). Calibrate probabilities (Platt scaling or\nCalibratedClassifierCV) so you can set a meaningful threshold.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Train offline in Python (scikit-learn). Calibrate probabilities (Platt scaling or CalibratedClassifierCV) so you can set a meaningful threshold.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "fxoIzMKd6veUDyVest5uX",
      "type": "text",
      "x": 270.99029541015625,
      "y": 3821,
      "width": 776.319580078125,
      "height": 50,
      "angle": 0,
