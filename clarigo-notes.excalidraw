      "isDeleted": false,
      "boundElements": null,
      "updated": 1756261202991,
      "link": null,
      "locked": false,
      "text": "Linear SVM (Support Vector Machine) → Similar linear model but trained with hinge\nloss; maximizes margin. Needs calibration for probabilities.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Linear SVM (Support Vector Machine) → Similar linear model but trained with hinge loss; maximizes margin. Needs calibration for probabilities.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
