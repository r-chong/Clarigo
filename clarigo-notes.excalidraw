      "versionNonce": 1738579796,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756177568182,
      "link": null,
      "locked": false,
      "text": "Batch up to 50 videoIds and call videos.list?part=snippet,contentDetails to get\ntitle, channelId, tags, categoryId, contentDetails.duration (ISO-8601) then\nparse to seconds.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Batch up to 50 videoIds and call videos.list?part=snippet,contentDetails to get title, channelId, tags, categoryId, contentDetails.duration (ISO-8601) then parse to seconds.",
      "autoResize": false,
      "lineHeight": 1.25
    },
