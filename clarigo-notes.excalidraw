    },
    {
      "id": "sVU_NHHVa2dBqLS6CmhQf",
      "type": "text",
      "x": 272.24029541015625,
      "y": 2883.5,
      "width": 780.6793823242188,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbU",
      "roundness": null,
      "seed": 768600276,
      "version": 26,
      "versionNonce": 751465068,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176103614,
      "link": null,
      "locked": false,
      "text": "Title + channel name (lowercase, strip punctuation/emojis kept as tokens), word\n1–2-grams + character 3–5-grams hashed into a fixed-size vector (e.g., 2^18\ndims). Hashing avoids shipping a vocab file and is deterministic client-side.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Title + channel name (lowercase, strip punctuation/emojis kept as tokens), word 1–2-grams + character 3–5-grams hashed into a fixed-size vector (e.g., 2^18 dims). Hashing avoids shipping a vocab file and is deterministic client-side.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "AUjm9HBjw9li46OYkTf_2",
