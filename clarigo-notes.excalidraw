      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Baseline (recommended): Linear Logistic Regression or Linear SVM on hashed\nfeatures (+ numeric features)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Baseline (recommended): Linear Logistic Regression or Linear SVM on hashed features (+ numeric features)",
      "autoResize": false,
