      "type": "text",
      "x": 270.99029541015625,
      "y": 3726,
      "width": 742.439453125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
