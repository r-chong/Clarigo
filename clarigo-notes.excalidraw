      "versionNonce": 884949100,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Channel-level priors: running mean label per channel (smoothed with a Beta prior,\ne.g., +3 pseudo-counts each side) as a scalar feature.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Channel-level priors: running mean label per channel (smoothed with a Beta prior, e.g., +3 pseudo-counts each side) as a scalar feature.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "17dwuRowXkgo9XwXUfJNb",
      "type": "text",
      "x": 272.24029541015625,
      "y": 3428.5,
      "width": 773.83935546875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bba",
      "roundness": null,
      "seed": 1489185108,
      "version": 25,
      "versionNonce": 1918128876,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689255,
      "link": null,
      "locked": false,
      "text": "Why this mix: simple linear models over TF-IDF/hashed n-grams + a few numeric\nfeatures usually beat tiny neural nets on short titles; they’re tiny, fast, and\ntransparent.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why this mix: simple linear models over TF-IDF/hashed n-grams + a few numeric features usually beat tiny neural nets on short titles; they’re tiny, fast, and transparent.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
