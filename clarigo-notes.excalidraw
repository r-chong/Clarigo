      "link": null,
      "locked": false,
      "text": "Keep if matches strong Edu verbs: how\nto|tutorial|course|lecture|explained|guide|derivation|proof|solve|walkthrough|build|i\nmplement|data structures|algorithms.",
      "fontSize": 20,
      "fontFamily": 5,
