      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Heads-up: For personal use, DOM reading/modifying is what content scripts are\ndesigned for, but always review YouTube’s ToS and avoid automated actions\nother than hide/overlay. Chrome MV3 content scripts are the right mechanism for\npage-context reads/writes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heads-up: For personal use, DOM reading/modifying is what content scripts are designed for, but always review YouTube’s ToS and avoid automated actions other than hide/overlay. Chrome MV3 content scripts are the right mechanism for page-context reads/writes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
