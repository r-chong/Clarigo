      "isDeleted": false,
      "boundElements": [],
      "updated": 1756175689256,
      "link": null,
      "locked": false,
      "text": "Build the sparse hashed vector on the fly from title + channel, append numeric\nfeatures, compute dot = w·x + b, then sigmoid(dot) to get p(Edu).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Build the sparse hashed vector on the fly from title + channel, append numeric features, compute dot = w·x + b, then sigmoid(dot) to get p(Edu).",
      "autoResize": false,
      "lineHeight": 1.25
    },
