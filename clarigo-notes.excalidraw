      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Use weak labels to scale to 20–50k quickly, then clean 500–1k via active learning\nto correct bias.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Use weak labels to scale to 20–50k quickly, then clean 500–1k via active learning to correct bias.",
