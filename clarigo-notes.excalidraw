      "isDeleted": false,
      "boundElements": [],
      "updated": 1756176414427,
      "link": null,
      "locked": false,
      "text": "Export: just the weight vector w + bias b, and your hash function spec. JS can\ndo a dot-product in milliseconds—no heavy runtime.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Export: just the weight vector w + bias b, and your hash function spec. JS can do a dot-product in milliseconds—no heavy runtime.",
      "autoResize": false,
      "lineHeight": 1.25
    },
